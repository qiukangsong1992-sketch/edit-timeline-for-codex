{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "module": "CommonJS",
    "moduleResolution": "Node",
    "outDir": "out",
    "rootDir": ".",
    "noUnusedLocals": false,
    "types": [
      "node",
      "mocha"
    ],
    "esModuleInterop": true
  },
  "include": [
    "integration/**/*.ts",
    "src/**/*.ts"
  ]
}
